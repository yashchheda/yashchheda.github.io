---
import type { Role } from '../data/resume';

interface Props {
  role: Role;
  /** The most recent role gets an open marker on the timeline. */
  current?: boolean;
}
const { role, current = false } = Astro.props;
---

<li class="reveal relative pl-8">
  <!-- Timeline rail + node -->
  <span class="absolute left-[5px] top-2.5 h-full w-px bg-line" aria-hidden="true"></span>
  <span
    class:list={[
      'absolute left-0 top-1.5 size-[11px] rounded-full border-2',
      current ? 'border-signal bg-signal/25' : 'border-brand-400 bg-canvas',
    ]}
    aria-hidden="true"></span>

  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h4 class="text-[15px] font-semibold text-ink">{role.title}</h4>
    <p class="font-mono text-xs whitespace-nowrap text-faint">{role.start} – {role.end}</p>
  </div>

  {role.scope && <p class="mt-2 text-[14.5px] leading-relaxed text-muted">{role.scope}</p>}

  <ul class="mt-3 space-y-1.5">
    {
      role.bullets.map((b) => (
        <li class="flex gap-2.5 text-[14px] leading-relaxed text-muted">
          <span class="mt-[7px] size-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />
          <span>{b}</span>
        </li>
      ))
    }
  </ul>
</li>
